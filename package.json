{
  "name": "cfs",
  "private": true,
  "version": "0.1.12",
  "description": "CFS - Combat Flight Simulator",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p .",
    "start": "tsc -p . && node scripts/serve.mjs",
    "test": "tsc -p . && node --test build/tests/*.test.js",
    "typecheck": "tsc -p . --noEmit",
    "build:site": "tsc -p . && node scripts/installable/build-site.mjs",
    "serve:site": "node scripts/serve.mjs --site",
    "release": "npm version patch && git push --follow-tags",
    "site": "npm run build:site && node scripts/serve.mjs --site"
  },
  "dependencies": {
    "@trystero-p2p/torrent": "^0.26.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@types/node": "^24.19.2",
    "@types/three": "0.186.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "typescript": "5.9.3"
  }
}
