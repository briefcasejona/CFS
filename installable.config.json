{
  "name": "CFS — Combat Flight Simulator",
  "shortName": "CFS",
  "description": "Combat flight simulator in the spirit of Falcon BMS and DCS: 6-DOF flight model, radar, missiles, dynamic campaign, HOTAS.",
  "themeColor": "#0d1720",
  "backgroundColor": "#0d1720",
  "display": "fullscreen",
  "orientation": "landscape",
  "entry": "index.html",
  "outDir": "site",
  "copy": [
    {
      "from": "build/src",
      "to": "js",
      "include": "\\.js$",
      "stripSourceMaps": true
    },
    {
      "from": "styles.css",
      "to": "styles.css"
    },
    {
      "from": "node_modules/three/build/three.module.js",
      "to": "vendor/three/three.module.js"
    },
    {
      "from": "node_modules/three/build/three.core.js",
      "to": "vendor/three/three.core.js"
    },
    {
      "from": "node_modules/three/examples/jsm/loaders/GLTFLoader.js",
      "to": "vendor/three/examples/jsm/loaders/GLTFLoader.js"
    },
    {
      "from": "node_modules/three/examples/jsm/utils/BufferGeometryUtils.js",
      "to": "vendor/three/examples/jsm/utils/BufferGeometryUtils.js"
    },
    {
      "from": "node_modules/three/examples/jsm/utils/SkeletonUtils.js",
      "to": "vendor/three/examples/jsm/utils/SkeletonUtils.js"
    },
    {
      "from": "assets/models",
      "to": "assets/models"
    },
    {
      "from": "node_modules/@trystero-p2p/core/dist",
      "to": "vendor/trystero/core",
      "include": ".mjs$"
    },
    {
      "from": "node_modules/@trystero-p2p/torrent/dist",
      "to": "vendor/trystero/torrent",
      "include": ".mjs$"
    }
  ],
  "noPrecache": [
    "assets/models/"
  ],
  "replace": [
    [
      "\"/node_modules/three/examples/jsm/\"",
      "\"./vendor/three/examples/jsm/\""
    ],
    [
      "/node_modules/three/build/three.module.js",
      "./vendor/three/three.module.js"
    ],
    [
      "href=\"/styles.css\"",
      "href=\"./styles.css\""
    ],
    [
      "src=\"/build/src/main.js\"",
      "src=\"./js/main.js\""
    ],
    [
      "\"/node_modules/@trystero-p2p/core/dist/index.mjs\"",
      "\"./vendor/trystero/core/index.mjs\""
    ],
    [
      "\"/node_modules/@trystero-p2p/torrent/dist/index.mjs\"",
      "\"./vendor/trystero/torrent/index.mjs\""
    ]
  ],
  "icon": {
    "background": "#14283a",
    "foreground": "#9fd8ff",
